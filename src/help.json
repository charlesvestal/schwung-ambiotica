{
  "title": "Ambiotica",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Ambient chain:",
        "looper to granular",
        "to micro-loop to",
        "modulated reverb.",
        "",
        "Four mode presets",
        "(Mismember, Loona,",
        "NAPS, Flow) reset",
        "the 8 knobs to a",
        "character starting",
        "point."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "1 Mix",
        "2 Loop Layer",
        "3 Grain Size",
        "4 Scatter",
        "5 Micro Hold",
        "6 Decay",
        "7 Mod Depth",
        "8 Mod Rate"
      ]
    },
    {
      "title": "Modes",
      "lines": [
        "Mismember: glitch",
        " grain textures",
        "",
        "Loona: rolling",
        " capture loops",
        "",
        "NAPS: frozen breath",
        " under lush tail",
        "",
        "Flow: pure modulated",
        " reverb (no capture)"
      ]
    },
    {
      "title": "Settings menu",
      "lines": [
        "Loop Length: bars",
        " (0.5 - 8.0)",
        "",
        "Mod Shape: Sine,",
        " Warp, Sink",
        "",
        "Tempo Sync: lock",
        " mod rate to BPM",
        "",
        "Lo-Fi Tails: half",
        " rate reverb,",
        " bitcrush character"
      ]
    },
    {
      "title": "Tips",
      "lines": [
        "Loop Length is",
        "tempo-aware - 1.5",
        "bars by default.",
        "",
        "Mod Depth bends",
        "both reverb and",
        "grain pitch.",
        "",
        "Micro Hold at max",
        "(>=95%) auto-",
        "freezes the layer."
      ]
    }
  ]
}
